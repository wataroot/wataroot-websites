---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const skills = ["HTML", "CSS", "JavaScript"];
---

<Layout title="About me | wataroot">
  <Header />
  <main class="pt-32 pb-20 px-6 max-w-3xl mx-auto space-y-10">
    <h1 class="text-3xl font-bold text-slate-100 border-b border-slate-800 pb-4">
      About Me
    </h1>
    <div class="space-y-4 text-slate-300 leading-relaxed">
      <p>
        初めまして。駆け出しプログラマーのサトウワタルです。
      </p>
      <p>
        情報系の大学を中退後、フリーで活動中です。
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-teal-400 mb-4">スキルセット</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-slate-200 font-mono">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>