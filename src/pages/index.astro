---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="わたのね">
  <Header />
  <main class="min-h-screen flex items-center justify-center pt-20 px-6">
    <div class="max-w-3xl text-center space-y-6">
      <p class="font-mono text-sm tracking-wider">WATAROOT</p>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-100 tracking-tight">
        わたのね
      </h1>
      <div class="pt-4 flex justify-center gap-4">
        <a href="/about" class="px-6 py-3 rounded-lg bg-teal-500 text-slate-900 font-semibold hover:bg-teal-400 transition-colors">
          About me
        </a>
        <a href="/collections" class="px-6 py-3 rounded-lg border border-slate-700 text-slate-300 font-semibold hover:border-slate-500 transition-colors">
          Collections
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>